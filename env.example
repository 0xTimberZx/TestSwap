# ─── TimbSwap Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. It is in .gitignore.
# NEVER share your DEPLOYER_PRIVATE_KEY with anyone. 

# ─── Deployer ─────────────────────────────────────────────────────────────────

# Private key of the deployer wallet (no 0x prefix needed by Foundry)
DEPLOYER_PRIVATE_KEY=

# ─── Network ──────────────────────────────────────────────────────────────────

# Arbitrum Sepolia RPC URL
# Free options: Alchemy, Infura, QuickNode, or public https://sepolia-rollup.arbitrum.io/rpc
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# Arbiscan API key (only needed for Etherscan verification — prefer Sourcify)
ARBISCAN_API_KEY=

# ─── Protocol Wallets ─────────────────────────────────────────────────────────

# Treasury / team wallet — receives initial TIMBS mint and protocol fees.
#
# This is TimbTreasury v4, and it must match config.js. Getting it wrong is not
# a recoverable mistake: PoolLedger, UnderwriteReserve and SegmentBoard all take
# `treasury` as an IMMUTABLE constructor arg, so a wrong value here routes every
# rake, dead pot and drain into the wrong contract for the life of the
# generation, fixable only by redeploying the whole generation.
#
# This file previously carried Treasury v1 (0x486Fa4D8…), which is retired and
# has no working ERC20 exit — SPECS.md records ~6,532 TIMBS already stranded in
# it. Deploying against that address would have repeated that, on purpose.
TREASURY_ADDRESS=0xd3F40042aFA8074EA68C9f61dE6aDADD539F0D5c

# Protocol sink — receives additional-round TIMBS fees (out of circulation)
# Can be the treasury wallet or a separate burn/sink address
PROTOCOL_SINK_ADDRESS=

# ─── Token Addresses (Arbitrum Sepolia) ───────────────────────────────────────

# WETH on Arbitrum Sepolia
WETH_ADDRESS=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73

# Existing DAPP token (0xtimberzx ecosystem)
DAPP_TOKEN_ADDRESS=0x3d0cB8929c22F93A9dd33921E6f43C1621FCfC04

# LINK token on Arbitrum Sepolia (for lock vault whitelist)
LINK_TOKEN_ADDRESS=0xb1D4538B4571d411F07960EF2838Ce337FE1E80E

# ─── TIMBS Token Config ───────────────────────────────────────────────────────

# Total initial TIMBS supply (18 decimals)
# 100,000,000 TIMBS = 100000000000000000000000000
INITIAL_SUPPLY=100000000000000000000000000

# Initial prize game entry cost in TIMBS (18 decimals)
# 100 TIMBS = 100000000000000000000
ENTRY_COST_TIMBS=100000000000000000000

# Initial prize game entry cost in ETH wei
# 0.001 ETH = 1000000000000000
ENTRY_COST_ETH=1000000000000000

# ─── Staking / Farm ───────────────────────────────────────────────────────────

# TIMBS staking reward rate per second (18 decimals)
# Example: 1 TIMBS/sec = 86,400 TIMBS/day
# Adjust based on intended APR and total staked expectation
REWARD_RATE_PER_SEC=1000000000000000000

# TIMBS farm (LP) reward rate per second (18 decimals)
# LP farm typically higher rate than single-asset staking
FARM_REWARD_RATE=2000000000000000000

# ─── Governance ───────────────────────────────────────────────────────────────

# Minimum TIMBS balance to submit a governance proposal (18 decimals)
# 1,000 TIMBS = 1000000000000000000000
PROPOSAL_THRESHOLD=1000000000000000000000

# Quorum requirement in basis points (10000 = 100%)
# 1000 = 10% of deposited voting power must participate
QUORUM_BPS=1000

# Voting period in seconds
# 604800 = 7 days
VOTING_PERIOD=604800

# Voting delay in seconds (time between proposal creation and voting start)
# 86400 = 1 day
VOTING_DELAY=86400

# ─── Settler (scripts/settler.js) ─────────────────────────────────────────────
# In production these live in GitHub Actions Secrets/Variables (see settler.yml
# and README), NOT in a committed file. Listed here only for local test runs.

# Settler wallet private key — signs settleSegment() txs. NEVER commit a real one.
SETTLER_PRIVATE_KEY=

# Telegram notifications (bot token + chat IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_PUBLIC=

# ─── Epoch keeper (scripts/epoch.js) ──────────────────────────────────────────
# Owner key that settles epochs, funds the waterfall, and runs buybacks. Secret.
EPOCH_PRIVATE_KEY=
# Block the first epoch scan measures from (only needed before epoch-state.json
# exists — e.g. on a fresh Treasury redeploy, reset this to the deploy block).
EPOCH_GENESIS_BLOCK=
# Buyback automation (section 0). All optional — sane defaults in the script.
BUYBACK_ENABLED=true       # set false to pause automated buybacks
BUYBACK_MIN_ETH=0.001      # skip when Treasury ETH is below this
BUYBACK_SPEND_BPS=10000    # % of available ETH to spend per run (10000 = 100%)
BUYBACK_SLIPPAGE_BPS=1500  # min-out tolerance (1500 = 15%, thin testnet pools)

# ─── X / Twitter auto-poster (scripts/xposter.js) ─────────────────────────────
# OAuth 1.0a user-context creds (app must have Read AND Write). Secrets — keep
# real values in .env or GitHub Secrets, never here.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Posting mode: all (default) | winners (only rounds that paid out) | off
X_POST_MODE=all

# Optional trailing hashtag line. Space/comma separated ("#" added if missing).
# Use "|" to separate rotation groups — they cycle by round number so posts
# aren't byte-identical. Trimmed to fit X's 280-char limit. Not a secret.
# X_HASHTAGS=TimbSwap Arbitrum DeFi Markets DApp Testnet | TimbSwap Arbitrum DeFi Markets Web3

# Optional override for winner (🏆) posts only; falls back to X_HASHTAGS.
# X_HASHTAGS_WINNER=TimbSwap Arbitrum OnchainGaming GameFi DeFi Markets DApp
